{
    "name": "kipchak/driver-couchdb",
    "type": "middleware",
    "description": "A CouchDB driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "CouchDB",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\CouchDB\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "mamluk/couchdb": "^0.10",
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-logger": "^1"
    }
}
