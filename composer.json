{
    "name": "kipchak/driver-couchdb",
    "type": "middleware",
    "description": "A Kipchak driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "CouchDB",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Mamluk\\Kipchak\\Middleware\\CouchDB\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "mamluk/couchdb": "^0.7.0"
    }
}
